#!/usr/bin/env python3
"""Durable SQLite queue for smartd notifications forwarded through PBS.

The forwarder MUST return non-zero on SMTP/target errors. Do not enable the
worker with stock Proxmox mail-forward builds: their notification bus logs
errors but reports exit status zero.
"""

from __future__ import annotations

import argparse
import fcntl
import logging
import os
from pathlib import Path
import sqlite3
import subprocess
import sys
import tempfile
import time
import uuid

SPOOL = Path(os.environ.get("PBS_SMART_QUEUE_DIR", "/var/spool/pbs-smart-mail"))
FORWARDER = os.environ.get("PBS_SMART_FORWARDER", "/opt/pbs/smart-alerts/pbs-smart-forward")
MAX_MESSAGE_BYTES = 256 * 1024
MAX_PENDING_BYTES = 16 * 1024 * 1024
MAX_PENDING_COUNT = 500
MAX_BATCH = 5
SEND_TIMEOUT_SECONDS = 30
PROTOCOL_MARKER = b"checked-delivery-v1"
LOG = logging.getLogger("pbs-smart-queue")


def connect() -> sqlite3.Connection:
    if SPOOL.is_symlink():
        raise RuntimeError(f"spool must not be a symlink: {SPOOL}")
    SPOOL.mkdir(mode=0o700, parents=True, exist_ok=True)
    if SPOOL.stat().st_mode & 0o077:
        raise RuntimeError(f"spool permissions must be 0700: {SPOOL}")
    db = SPOOL / "queue.sqlite3"
    if db.is_symlink():
        raise RuntimeError("database must not be a symlink")
    conn = sqlite3.connect(db, timeout=10, isolation_level=None)
    os.chmod(db, 0o600)
    conn.execute("PRAGMA journal_mode=WAL")
    conn.execute("PRAGMA synchronous=FULL")
    conn.execute("PRAGMA busy_timeout=10000")
    conn.execute("""
        CREATE TABLE IF NOT EXISTS mail_queue (
            id TEXT PRIMARY KEY,
            body BLOB NOT NULL,
            created_at INTEGER NOT NULL,
            next_attempt_at INTEGER NOT NULL,
            attempts INTEGER NOT NULL DEFAULT 0,
            last_error TEXT NOT NULL DEFAULT ''
        )
    """)
    conn.execute("CREATE INDEX IF NOT EXISTS idx_mail_due ON mail_queue(next_attempt_at, created_at)")
    return conn


def enqueue(path: Path) -> None:
    if not path.is_file():
        raise ValueError("input must be a regular file")
    with path.open("rb") as stream:
        data = stream.read(MAX_MESSAGE_BYTES + 1)
    if not data or len(data) > MAX_MESSAGE_BYTES:
        raise ValueError("empty message or message exceeds 256 KiB")
    now = int(time.time())
    with connect() as conn:
        # Serializable admission limit: hold the write transaction while checking capacity.
        conn.execute("BEGIN IMMEDIATE")
        count, size = conn.execute(
            "SELECT count(*), coalesce(sum(length(body)),0) FROM mail_queue"
        ).fetchone()
        if count >= MAX_PENDING_COUNT or size + len(data) > MAX_PENDING_BYTES:
            raise RuntimeError(
                f"queue full ({count} messages, {size} bytes); original alert NOT queued"
            )
        message_id = f"{now}-{uuid.uuid4().hex}"
        conn.execute(
            "INSERT INTO mail_queue (id, body, created_at, next_attempt_at) VALUES (?, ?, ?, ?)",
            (message_id, data, now, now),
        )
    LOG.info("queued id=%s bytes=%d", message_id, len(data))


def _checked_helper_available() -> bool:
    # The stock Proxmox helper exits 0 even when SMTP delivery fails.
    # The patched helper must affirm the checked-delivery protocol.
    custom = os.environ.get("PBS_SMART_PROTOCOL_CHECK")
    cmd = [custom] if custom else [
        "/usr/bin/docker", "exec", "pbs", "/usr/bin/proxmox-mail-forward",
        "--pbs-smart-queue-protocol",
    ]
    try:
        result = subprocess.run(
            cmd, capture_output=True, timeout=8, check=False,
        )
        return result.returncode == 0 and result.stdout.strip() == PROTOCOL_MARKER
    except (OSError, subprocess.TimeoutExpired):
        return False


def _deliver(data: bytes) -> tuple[bool, str]:
    if not _checked_helper_available():
        return False, "checked-delivery helper unavailable or unverified"
    with tempfile.NamedTemporaryFile(prefix="send-", suffix=".eml", dir=SPOOL, delete=False) as stream:
        name = stream.name
        os.chmod(name, 0o600)
        stream.write(data)
    try:
        try:
            result = subprocess.run(
                [FORWARDER, name],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                timeout=SEND_TIMEOUT_SECONDS,
                check=False,
            )
        except subprocess.TimeoutExpired:
            return False, f"forwarder timed out after {SEND_TIMEOUT_SECONDS}s"
        if result.returncode == 0:
            return True, ""
        # Do not log the forwarder's stderr or the alert body: it may contain mail data.
        return False, f"forwarder exit status {result.returncode}"
    except OSError as exc:
        return False, f"forwarder invocation failed: {type(exc).__name__}"
    finally:
        os.unlink(name)


def drain() -> None:
    lock_path = SPOOL / "worker.lock"
    with open(lock_path, "a+b") as lock:
        os.chmod(lock_path, 0o600)
        try:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            LOG.info("worker already running; exiting")
            return
        with connect() as conn:
            rows = conn.execute(
                """SELECT id, body, attempts FROM mail_queue
                   WHERE next_attempt_at <= ?
                   ORDER BY created_at, id LIMIT ?""",
                (int(time.time()), MAX_BATCH),
            ).fetchall()
            for message_id, body, attempts in rows:
                good, error = _deliver(body)
                if good:
                    conn.execute("DELETE FROM mail_queue WHERE id = ?", (message_id,))
                    LOG.info("forwarded id=%s after_attempt=%d", message_id, attempts + 1)
                else:
                    retries = attempts + 1
                    delay = min(3600, 60 * (2 ** min(attempts, 6)))
                    conn.execute(
                        """UPDATE mail_queue SET attempts=?, next_attempt_at=?, last_error=?
                           WHERE id=?""",
                        (retries, int(time.time()) + delay, error, message_id),
                    )
                    LOG.error(
                        "pending id=%s attempt=%d retry_in=%ds reason=%s",
                        message_id, retries, delay, error,
                    )


def status() -> None:
    with connect() as conn:
        count, size, oldest, waiting = conn.execute(
            """SELECT count(*), coalesce(sum(length(body)),0),
                      min(created_at), coalesce(sum(CASE WHEN attempts > 0 THEN 1 ELSE 0 END),0)
               FROM mail_queue"""
        ).fetchone()
        print(f"pending={count} bytes={size} previously_failed={waiting}")
        if oldest is not None:
            print(f"oldest_age_seconds={max(0, int(time.time()) - oldest)}")
        # Do not print email contents.


def main() -> int:
    logging.basicConfig(level=logging.INFO, format="%(levelname)s %(message)s")
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    put = commands.add_parser("enqueue", help="durably save an RFC 822 message")
    put.add_argument("file", type=Path)
    commands.add_parser("run", help="retry due messages")
    commands.add_parser("status", help="show queue counters")
    args = parser.parse_args()
    try:
        if args.command == "enqueue":
            enqueue(args.file)
        elif args.command == "run":
            drain()
        else:
            status()
        return 0
    except (OSError, RuntimeError, ValueError, sqlite3.Error) as exc:
        LOG.critical("queue operation %s failed: %s", args.command, exc)
        return 1


if __name__ == "__main__":
    sys.exit(main())
