[Unit]
Description=Retry durable SMART alerts through Proxmox Backup Server
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=root
ExecStart=/opt/pbs/smart-alerts/pbs-smart-queue run
TimeoutStartSec=190
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/spool/pbs-smart-mail
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
